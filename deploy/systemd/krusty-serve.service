[Unit]
Description=Krusty self-hosted server
Requires=krusty-mako.socket
After=network-online.target krusty-mako.socket
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=/usr/bin/env krusty serve --port 3000
Environment=RUST_LOG=info
Environment=PATH=%h/.local/bin:%h/.cargo/bin:%h/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=default.target
