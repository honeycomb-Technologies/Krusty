[Unit]
Description=Krusty Mako autonomous backend daemon
Requires=krusty-mako.socket
After=network-online.target krusty-mako.socket
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=/usr/bin/env krusty-mako daemon --socket %t/krusty/mako.sock --key %h/.krusty/run/mako-ipc.key
Environment=RUST_LOG=krusty_mako=info
Environment=PATH=%h/.local/bin:%h/.cargo/bin:%h/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# User services inherit the user manager's environment. Deployments should add
# an UnsetEnvironment= drop-in for unrelated credentials and bootstrap tokens;
# keep only provider/push variables intentionally trusted by Mako.
Restart=always
RestartSec=2s
TimeoutStopSec=45s
KillMode=mixed
OOMPolicy=stop
UMask=0077
LimitNOFILE=65536
TasksMax=512

# Mako needs the project tree and its own state, but not arbitrary home writes.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=-%h/.krusty -%h/Work -%h/.cargo -%h/.bun -%h/.cache -%h/.npm -%h/.local/share
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=default.target
Also=krusty-mako.socket
