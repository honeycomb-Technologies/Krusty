[Unit]
Description=Mitsuro self-hosted server
Requires=mitsuro-hive.socket
After=network-online.target mitsuro-hive.socket
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=%h/.local/bin/.mitsuro-current/mitsuro serve --port 3000
Environment=RUST_LOG=info
Environment=PATH=%h/.local/bin:%h/.cargo/bin:%h/.bun/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=MITSURO_AGENT_BROWSER_PATH=%h/.local/bin/.mitsuro-current/agent-browser
# PATH is for subprocesses; it never selects the server binary.
Restart=on-failure
RestartSec=3
TimeoutStopSec=30

[Install]
WantedBy=default.target
