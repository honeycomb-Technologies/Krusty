# Maintainer: Burgess <burgess@example.com>
pkgname=krusty
pkgver=0.7.3
pkgrel=1
pkgdesc="Mitsuro multi-platform AI coding product with Agent and Hive"
arch=('x86_64' 'aarch64')
url="https://github.com/honeycomb-Technologies/Krusty"
license=('MIT')
depends=('gcc-libs' 'openssl')
makedepends=('cargo')
source=("$pkgname-$pkgver.tar.gz::https://github.com/honeycomb-Technologies/Krusty/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('7f21b43dab2607d8864de641e7f11c920e73fdaee378f9c1115dadf4760fcbfa')

prepare() {
    cd "Krusty-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
    cd "Krusty-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    export CARGO_PROFILE_RELEASE_LTO=false
    cargo build --frozen --release -p krusty
    if [[ -f crates/krusty-mako/Cargo.toml ]]; then
        cargo build --frozen --release -p krusty-mako
    fi
}

check() {
    cd "Krusty-$pkgver"
    export RUSTUP_TOOLCHAIN=stable
    export CARGO_TARGET_DIR=target
    cargo test --frozen --release
}

package() {
    cd "Krusty-$pkgver"
    install -Dm755 "target/release/krusty" "$pkgdir/usr/bin/krusty"
    if [[ -f crates/krusty-mako/Cargo.toml ]]; then
        install -Dm755 "target/release/krusty-mako" "$pkgdir/usr/bin/krusty-mako"
        install -Dm644 deploy/systemd/krusty-mako.socket \
            "$pkgdir/usr/lib/systemd/user/krusty-mako.socket"
        install -Dm644 deploy/systemd/krusty-mako.service \
            "$pkgdir/usr/lib/systemd/user/krusty-mako.service"
        install -Dm644 deploy/systemd/krusty-serve.service \
            "$pkgdir/usr/lib/systemd/user/krusty-serve.service"
    fi
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
