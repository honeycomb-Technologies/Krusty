{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "moduleSuffixes": [".native", ".web", ""],
    "paths": {
      "@mitsuro/api": ["../../packages/api/src"],
      "@mitsuro/state": ["../../packages/state/src"],
      "@mitsuro/ui": ["../../packages/ui/src"],
      "zustand": ["./node_modules/zustand"],
      "zustand/*": ["./node_modules/zustand/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../packages/*/src/**/*.ts"
  ]
}
