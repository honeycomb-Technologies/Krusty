{
  "expo": {
    "name": "Krusty",
    "slug": "krusty",
    "version": "0.9.8",
    "orientation": "portrait",
    "icon": "./assets/icons/ios-light.png",
    "userInterfaceStyle": "automatic",
    "scheme": "krusty",
    "splash": {
      "backgroundColor": "#0b1119"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "io.krusty.mobile",
      "buildNumber": "218",
      "backgroundColor": "#0b1119",
      "icon": {
        "light": "./assets/icons/ios-light.png",
        "dark": "./assets/icons/ios-dark.png",
        "tinted": "./assets/icons/ios-tinted.png"
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification",
          "fetch"
        ],
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "io.krusty.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0b1119"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b1119"
        }
      ],
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/ios-light.png",
          "color": "#ff6b35"
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Allow Krusty to take photos for attachments",
          "photosPermission": "Allow Krusty to access photos for attachments"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Krusty to use the microphone for voice input",
          "speechRecognitionPermission": "Allow Krusty to use speech recognition for voice input"
        }
      ],
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.io.krusty.mobile",
          "enablePushNotifications": true,
          "frequentUpdates": true,
          "widgets": [
            {
              "name": "MakoWidget",
              "displayName": "Mako Status",
              "description": "Daily updates and status from your Mako agent",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "systemLarge",
                "accessoryCircular",
                "accessoryRectangular",
                "accessoryInline"
              ],
              "contentMarginsDisabled": false
            },
            {
              "name": "ChatWidget",
              "displayName": "Krusty Chat",
              "description": "Active chat status and quick launch",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium",
                "accessoryCircular",
                "accessoryRectangular"
              ],
              "contentMarginsDisabled": false
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "6e327449-af3c-4138-b1c4-7ceca2baf243"
      }
    },
    "owner": "j-burgess"
  }
}
