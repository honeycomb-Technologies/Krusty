{
  "name": "@krusty/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:catalog": "bun run scripts/sync-plugin-catalog.ts",
    "dev": "bun run sync:catalog && vite dev --host 127.0.0.1",
    "build": "bun run sync:catalog && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "check": "bun run sync:catalog && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.21.5",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "@types/node": "^25.9.2",
    "svelte": "^5.34.5",
    "svelte-check": "^4.2.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
