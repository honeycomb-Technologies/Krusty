{
  "expo": {
    "name": "Mitsuro Desktop",
    "slug": "mitsuro-desktop",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "../../mobile/assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "mitsuro-desktop",
    "splash": {
      "backgroundColor": "#0b1119"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "../../mobile/assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font"
    ]
  }
}
