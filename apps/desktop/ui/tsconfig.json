{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "moduleSuffixes": [
      ".web",
      ".native",
      ""
    ],
    "paths": {
      "@mitsuro/api": [
        "../../../packages/api/src"
      ],
      "@mitsuro/state": [
        "../../../packages/state/src"
      ],
      "@mitsuro/ui": [
        "../../../packages/ui/src"
      ],
      "@mobile/*": [
        "../../mobile/*"
      ],
      "zustand": [
        "./node_modules/zustand"
      ],
      "zustand/*": [
        "./node_modules/zustand/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    "../../../packages/*/src/**/*.ts",
    "../../mobile/**/*.ts",
    "../../mobile/**/*.tsx"
  ]
}
