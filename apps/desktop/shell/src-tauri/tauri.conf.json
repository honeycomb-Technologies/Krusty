{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mitsuro",
  "version": "0.9.14",
  "identifier": "io.krusty.desktop",
  "build": {
    "beforeDevCommand": "cd ../../mobile && npx expo start --web --port 5173",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../../mobile && npx expo export --platform web",
    "frontendDist": "../../../mobile/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Mitsuro",
        "width": 1280,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 680,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon-32.png",
      "icons/icon-64.png",
      "icons/icon-128.png",
      "icons/icon-256.png",
      "icons/icon-512.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Honeycomb Technologies",
    "homepage": "https://github.com/honeycomb-Technologies/Krusty",
    "category": "DeveloperTool",
    "shortDescription": "Mitsuro, a local-first AI coding assistant.",
    "longDescription": "Mitsuro packages Agent and Hive in a native desktop shell with an embedded local runtime for coding, chat, and project operations.",
    "license": "MIT",
    "licenseFile": "../../../../LICENSE",
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional"
      }
    }
  }
}
