# Krusty Dev .gitignore

# Internal configuration
CLAUDE.md
.claude/worktrees/

# Build outputs
target/
.fastembed_cache/
**/target/
**/dist/
**/.krusty-shadow/

# MCP configuration (user-specific)
.mcp.json
.mcp_overrides.json

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Frontend build
frontend/node_modules
frontend/build

# Lockfile policy: Bun only
**/package-lock.json
**/pnpm-lock.yaml
**/yarn.lock

# Never publish archive snapshots from this repo
apps/**/legacy*/
apps/**/legacy-*/

# Secrets, credentials, and keys — never commit these
.env
.env.*
!.env.example
credentials.json
oauth.json
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
.krusty/
